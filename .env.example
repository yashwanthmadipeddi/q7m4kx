# Elexon Insights API base URL
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Default day-ahead decision cutoff on the previous day, in Europe/London time
DECISION_CUTOFF_HOUR=11

# Cache successful Elexon dataset responses for this many seconds
ELEXON_CACHE_SECONDS=300
ELEXON_TIMEOUT_SECONDS=35

# Port used by the Dockerized application
PORT=8000
